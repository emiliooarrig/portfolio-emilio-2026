# ─── App ─────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Genera uno con: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# true solo si estás detrás de un proxy/CDN de confianza
TRUST_PROXY=false

# ─── Base de datos (guarda los mensajes de contacto) ─
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=

# ─── Correo (PHPMailer por SMTP) ─────────────────────
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
# En Gmail usa una "contraseña de aplicación", no la de tu cuenta
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Portafolio Emilio Guzmán"
# A dónde llegan los mensajes del formulario
CONTACT_TO=

# ─── Límite de envíos del formulario ─────────────────
CONTACT_MAX_ATTEMPTS=5
CONTACT_WINDOW_SECONDS=600

# ─── Datos públicos (vacío = se muestra [PLACEHOLDER]) ─
PUBLIC_EMAIL=
LINKEDIN_URL=
RESPONSE_TIME="24–48 h"
FOVEA_URL=
# Solo dígitos con lada, p. ej. 5215512345678
FOVEA_WHATSAPP=
